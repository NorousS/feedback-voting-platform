{
  "name": "@feedback/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @feedback/ui",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run build -w @feedback/ui",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "lint": "eslint  --max-warnings 0",
    "lint:fix": "eslint  --fix",
    "pretest": "npm run build -w @feedback/ui",
    "test": "vitest run",
    "pretest:coverage": "npm run build -w @feedback/ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@feedback/ui": "0.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.1",
    "vite": "8.2.6",
    "vitest": "5.1.1"
  }
}
